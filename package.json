{
  "name": "theokit-di-monorepo",
  "private": true,
  "releaseChannel": "next",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.34.1"
  },
  "packageManager": "pnpm@10.34.1+sha512.b58fbde6dca66a929538021581f648b4570b6ca19b18e7cbd7f2c07a7b24454155388dacdf08f2af3678e88a6d1fe04f9d609df24bf51735a060ea041b374ab7",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r --no-bail run test:coverage",
    "typecheck": "pnpm -r run typecheck",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "quality:doc-orphans": "node tools/check-orphan-docblocks.mjs",
    "quality:doc-api": "node tools/check-doc-api-drift.mjs",
    "quality:doc-coverage": "node tools/check-doc-coverage.mjs",
    "quality:docs": "pnpm quality:doc-orphans && pnpm quality:doc-api && pnpm quality:doc-coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "better-sqlite3",
      "esbuild"
    ]
  }
}
